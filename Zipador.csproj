<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App Metadata -->
    <AssemblyName>Zipador</AssemblyName>
    <Product>Zipador</Product>
    <Description>ZIP/RAR Compression CLI Tool</Description>
    <Version>1.0.0</Version>

    <!-- Publish settings for single exe (requires self-contained) -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <SelfContained>true</SelfContained> -->
    <!-- <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.47.4" />
  </ItemGroup>

</Project>